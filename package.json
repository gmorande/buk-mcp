{
  "name": "buk-mcp",
  "version": "0.1.0",
  "description": "Community MCP for the official Buk API, payroll history and personnel cost analytics",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": { "node": ">=22" },
  "bin": { "buk-mcp": "dist/index.js" },
  "files": ["dist", "schema", "data", "README.md", "LICENSE", "docs"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "test:live": "node --import tsx scripts/live-test.ts",
    "schema:update": "node --import tsx scripts/update-schema.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.17.1",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
