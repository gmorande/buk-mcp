# Never commit a real .env or API key. Use your deployment's secret manager.
# Local stdio, or a single-tenant HTTP deployment in bearer mode:
BUK_TENANT_URL=https://your-company.buk.cl
BUK_API_KEY=replace-with-your-own-buk-key
BUK_COUNTRY=chile
BUK_ALLOW_WRITES=false
BUK_MAX_PAGES=100
BUK_TIMEOUT_MS=30000

# Remote HTTP: default is multi-tenant OAuth, each user connects their own Buk.
BUK_AUTH_MODE=oauth
PUBLIC_URL=https://mcp.your-domain.example
HOST=127.0.0.1
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_MASTER_KEY=replace-with-32-random-bytes-as-base64
OAUTH_DATA_DIR=.buk-mcp
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform/oauth_redirect

# Only for BUK_AUTH_MODE=bearer; this is a NEW random connector token, not your Buk key.
BUK_MCP_ACCESS_TOKEN=replace-with-a-separate-random-token-of-at-least-32-characters
